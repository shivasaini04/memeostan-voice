# One operator, local app. Use https://your-host and COOKIE_SECURE=1 for remote use.
PUBLIC_ORIGIN=http://localhost:8000
COOKIE_SECURE=0
VOICE_TENANT_ID=1

# Choose models available in YOUR provider account; no fallback model is enabled.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Puck
GEMINI_LIVE_FALLBACKS=
GEMINI_PREWARM=0
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=aditya
SARVAM_STT_MODEL=saarika:v2.5
OPENROUTER_API_KEY=
VOICE_LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Calls require all three: explicit enable, allowlisted owned numbers, DB credentials.
# No numbers, paid calls or email are enabled by this template.
ENABLE_OUTBOUND_CALLS=0
ALLOWED_TEST_NUMBERS=
SUPPRESSED_NUMBERS=
CALL_HOUR_START=9
CALL_HOUR_END=21
EXOTEL_SUBDOMAIN=api.exotel.com
# Separate incoming-stream Basic credentials, NOT your Exotel account API keys.
EXOTEL_STREAM_USER=voicebot
EXOTEL_STREAM_PASSWORD=
MAX_CALL_SECONDS=180

# Audio recording and detailed local logs contain personal data. Opt in deliberately.
RECORD_CALLS=0
FILE_LOGGING=0
PRIVATE_DEBUG_LOGS=0
# SQLite still stores call transcripts, history, bookings and operator credentials.
# VOICE_DB=/absolute/private/path/voice_agent.db

# Optional email side effect, using only this operator's explicit sender.
ENABLE_EMAIL=0
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
